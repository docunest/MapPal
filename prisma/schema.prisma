generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (transaction mode, port 6543) for the app's own runtime queries —
  // required on serverless, where every request may be a fresh connection.
  url       = env("DATABASE_URL")
  // Unpooled/session mode (port 5432) for `prisma migrate deploy`, which
  // needs features (advisory locks, DDL) a transaction-mode pooler can't do.
  directUrl = env("DIRECT_URL")
}

// Every table/enum in this schema is prefixed "mappal_" because this app
// shares one Supabase Postgres project (public schema) with other persona
// apps. Convention + prefix registry: see docunest/shared-supabase.
// Do not add an unprefixed model/enum here — it WILL collide with another
// app's table of the same name.

// --- Auth: tiny shared-family user list, no per-user data scoping ---
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  loginTokens LoginToken[]

  @@map("mappal_user")
}

// --- Admin-minted, single-use magic-login links (30-day expiry by
// convention, enforced by the minting endpoint, not the schema). Lets a
// family member sign in without typing a password, and lets this session
// log in to verify deploys without ever holding real credentials.
model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("mappal_login_token")
}

// --- A region the user has asked the agent to index, e.g. "Galicia" ---
// boundary is a GeoJSON Polygon/MultiPolygon drawn on the map (or imported).
model Region {
  id          String   @id @default(cuid())
  name        String
  boundary    Json // GeoJSON geometry
  h3Resolution Int     @default(7) // ~5km edge; tune per region size
  createdAt   DateTime @default(now())
  tiles       Tile[]

  @@index([name])
  @@map("mappal_region")
}

// --- One H3 hex cell covering part of a region ---
model Tile {
  id        String   @id @default(cuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  h3Index   String   @unique
  centerLat Float
  centerLng Float
  boundary  Json // GeoJSON polygon of the hex, for map rendering
  note      String? // optional short "character of the area" note
  createdAt DateTime @default(now())

  jobs   ScanJob[]
  places Place[]

  @@index([regionId])
  @@map("mappal_tile")
}

// --- A category definition, e.g. "waterfalls". Config lives in code
// (lib/categories/*.ts); this row just lets jobs/places reference it stably
// and lets the coverage dashboard list categories without redeploying.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique // matches the key in lib/categories
  label       String
  description String
  createdAt   DateTime @default(now())

  jobs   ScanJob[]
  places Place[]

  @@map("mappal_category")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  ERROR

  @@map("mappal_job_status")
}

// --- The anti-skipping ledger: one row per (tile, category). ---
model ScanJob {
  id           String    @id @default(cuid())
  tileId       String
  tile         Tile      @relation(fields: [tileId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status       JobStatus @default(PENDING)
  sourcesTried Json? // which collectors ran (overpass, web, wikiloc, ...)
  candidateCount Int     @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([tileId, categoryId])
  @@index([status])
  @@map("mappal_scan_job")
}

enum PlaceVisitStatus {
  UNKNOWN
  MUST_VISIT
  VISITED
  SKIPPED

  @@map("mappal_place_visit_status")
}

// --- A discovered point of interest ---
model Place {
  id            String   @id @default(cuid())
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  tileId        String?
  tile          Tile?    @relation(fields: [tileId], references: [id])
  lat           Float
  lng           Float
  description   String?
  season        String? // e.g. best visited in; "dries up in summer"
  accessNotes   String?
  openingHours  String?
  popularityScore Float?  // review counts / mentions / photo density
  qualityScore    Float?  // rule match / richness
  isHiddenGem     Boolean @default(false)
  confidence      Float?  // 0-1, how sure the agent is this is real/correct
  lastVerifiedAt  DateTime?
  visitStatus     PlaceVisitStatus @default(UNKNOWN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sources PlaceSource[]

  @@index([categoryId])
  @@index([lat, lng])
  @@map("mappal_place")
}

// --- Every source backing a place: no place without provenance ---
model PlaceSource {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type      String // "osm" | "wikipedia" | "web" | "wikiloc" | "instagram-manual" | ...
  url       String?
  raw       Json? // raw snippet/tags fetched, for re-verification without re-fetching
  fetchedAt DateTime @default(now())

  @@map("mappal_place_source")
}
