generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (transaction mode, port 6543) for the app's own runtime queries —
  // required on serverless, where every request may be a fresh connection.
  url       = env("DATABASE_URL")
  // Unpooled/session mode (port 5432) for `prisma migrate deploy`, which
  // needs features (advisory locks, DDL) a transaction-mode pooler can't do.
  directUrl = env("DIRECT_URL")
}

// Every table/enum in this schema is prefixed "mappal_" because this app
// shares one Supabase Postgres project (public schema) with other persona
// apps. Convention + prefix registry: see docunest/shared-supabase.
// Do not add an unprefixed model/enum here — it WILL collide with another
// app's table of the same name.

// --- Auth: tiny shared-family user list, no per-user data scoping ---
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  loginTokens LoginToken[]

  @@map("mappal_user")
}

// --- Admin-minted, single-use magic-login links (30-day expiry by
// convention, enforced by the minting endpoint, not the schema). Lets a
// family member sign in without typing a password, and lets this session
// log in to verify deploys without ever holding real credentials.
model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("mappal_login_token")
}

// --- A region the user has asked the agent to index, e.g. "Galicia" ---
// boundary is a GeoJSON Polygon/MultiPolygon drawn on the map (or imported).
model Region {
  id          String   @id @default(cuid())
  name        String
  boundary    Json // GeoJSON geometry
  h3Resolution Int     @default(7) // ~5km edge; tune per region size
  createdAt   DateTime @default(now())
  tiles       Tile[]

  @@index([name])
  @@map("mappal_region")
}

// --- One H3 hex cell covering part of a region ---
model Tile {
  id        String   @id @default(cuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  h3Index   String   @unique
  centerLat Float
  centerLng Float
  boundary  Json // GeoJSON polygon of the hex, for map rendering
  note      String? // optional short "character of the area" note
  createdAt DateTime @default(now())

  jobs   ScanJob[]
  places Place[]

  @@index([regionId])
  @@map("mappal_tile")
}

// --- A category definition, e.g. "waterfalls". Editable via /categories —
// this IS the source of truth (lib/categories/*.ts only seeds first-run
// defaults, it isn't read at scan time).
//
// IMPORTANT, re: what's AI vs. static lookup — today every field below
// except overpassFilters/elementTypes is inert. Only overpassFilters drives
// results, via a deterministic OSM/Overpass tag match: no judgment, no AI,
// same query every time. include/exclude/searchPhrases/extractFields are
// captured for a future LLM verification/web-search pass that doesn't exist
// yet (see aiAssisted below, always false until that's built). The
// /categories UI must keep saying so — don't let it imply these rules
// already filter anything.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Static lookup (live): actually drives the Overpass collector ---
  elementTypes    Json // string[] of "node"|"way"|"relation"
  overpassFilters Json // {key: string, value?: string}[]

  // --- Captured for a future AI-assisted pass (NOT used by any collector
  // yet — see the model comment above) ---
  include       Json // string[]
  exclude       Json // string[]
  searchPhrases Json // string[]
  extractFields Json // string[]
  aiAssisted    Boolean @default(false)

  jobs   ScanJob[]
  places Place[]

  @@map("mappal_category")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  ERROR

  @@map("mappal_job_status")
}

// --- The anti-skipping ledger: one row per (tile, category). ---
model ScanJob {
  id           String    @id @default(cuid())
  tileId       String
  tile         Tile      @relation(fields: [tileId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status       JobStatus @default(PENDING)
  sourcesTried Json? // which collectors ran (overpass, web, wikiloc, ...)
  candidateCount Int     @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([tileId, categoryId])
  @@index([status])
  @@map("mappal_scan_job")
}

enum PlaceVisitStatus {
  UNKNOWN
  MUST_VISIT
  VISITED
  SKIPPED

  @@map("mappal_place_visit_status")
}

// --- A discovered point of interest ---
model Place {
  id            String   @id @default(cuid())
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  tileId        String?
  tile          Tile?    @relation(fields: [tileId], references: [id])
  lat           Float
  lng           Float
  description   String?
  season        String? // e.g. best visited in; "dries up in summer"
  accessNotes   String?
  openingHours  String?
  popularityScore Float?  // review counts / mentions / photo density
  qualityScore    Float?  // rule match / richness
  isHiddenGem     Boolean @default(false)
  confidence      Float?  // 0-1, how sure the agent is this is real/correct
  lastVerifiedAt  DateTime?
  visitStatus     PlaceVisitStatus @default(UNKNOWN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sources PlaceSource[]

  @@index([categoryId])
  @@index([lat, lng])
  @@map("mappal_place")
}

// --- Every source backing a place: no place without provenance ---
model PlaceSource {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type      String // "osm" | "wikipedia" | "web" | "wikiloc" | "instagram-manual" | ...
  url       String?
  raw       Json? // raw snippet/tags fetched, for re-verification without re-fetching
  fetchedAt DateTime @default(now())

  @@map("mappal_place_source")
}

// --- The family's shared trip list: spots saved from Scout (or Lens) to
// visit later. Shared by everyone, like the rest of the data; savedBy is
// just "who found this".
model SavedSpot {
  id        String           @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  kind      String // Scout/Lens kind slug, e.g. "waterfall", "lost-place"
  // Stable identity of the underlying thing ("osm:node/123", "wd:Q1") so
  // saving the same spot twice doesn't duplicate it.
  sourceKey String           @unique
  wikidata  String?
  imageUrl  String?
  note      String?
  status    PlaceVisitStatus @default(MUST_VISIT)
  savedBy   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@map("mappal_saved_spot")
}

// --- Sources framework (docs/PLAN.md §7a) ---------------------------------

// Calls made per paid source/SKU per day — the app-side cost guardrail.
// lib/sources/usage.ts refuses a call once a daily or monthly cap is hit.
model SourceUsage {
  id     String @id @default(cuid())
  source String // SourceId, e.g. "google"
  sku    String // e.g. "place-details-atmosphere"
  day    String // "YYYY-MM-DD" (UTC)
  count  Int    @default(0)

  @@unique([source, sku, day])
  @@map("mappal_source_usage")
}

// On/off switch per source, set on /sources. No row = on (if configured).
model SourceSetting {
  source    String   @id
  enabled   Boolean
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("mappal_source_setting")
}

// 👍/👎 on places and on the sources that informed them (§7c).
// targetType "place": targetKey = place key, value +1 only (also saved to
// the family list). targetType "source": targetKey = source id, placeKey =
// the place it was shown for, value +1/-1.
model Feedback {
  id         String   @id @default(cuid())
  userEmail  String
  targetType String
  targetKey  String
  placeKey   String   @default("") // "" for place likes (NULLs aren't unique in Postgres)
  placeKind  String?
  value      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userEmail, targetType, targetKey, placeKey])
  @@index([targetType, targetKey])
  @@map("mappal_feedback")
}

// --- Shared, editable prompt templates (§7b) ------------------------------

// Seeded once from lib/prompts/defaults.ts; after that the DB is the source
// of truth. Edited on /prompts (people) or /api/admin/prompts (agents).
model PromptTemplate {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String
  body        String
  updatedBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PromptVersion[]

  @@map("mappal_prompt_template")
}

// Every save, so any earlier version can be restored.
model PromptVersion {
  id         String         @id @default(cuid())
  templateId String
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  body       String
  createdBy  String
  note       String?
  createdAt  DateTime       @default(now())

  @@index([templateId, createdAt])
  @@map("mappal_prompt_version")
}

// --- Car dock (docunest/android-apps: dock app on the head unit) ----------

// A place the head unit can drive to. "link": sent from a phone's share
// button (Google Maps / Waze / Apple Maps link, or plain coordinates) — kept
// forever as history, newest first. "bookmark": "I like this place", saved
// on the head unit from its own GPS. Coordinates come from parsing the link
// (static lookup, no AI); when a link has none, from a Nominatim search of
// its place name — `locatedBy` says which, so the app never shows a guessed
// pin as exact.
model DockItem {
  id        String    @id @default(cuid())
  kind      String // "link" | "bookmark"
  title     String
  // What the phone sent (link or text) and where it ended up after
  // following redirects (maps.app.goo.gl → google.com/maps/place/...).
  sourceUrl   String?
  resolvedUrl String?
  lat       Float?
  lng       Float?
  // "link" (coordinates were in the URL), "search" (geocoded from the place
  // name), "gps" (head-unit bookmark), "none" (couldn't place it: the app
  // can still open the original link)
  locatedBy String
  address   String?
  note      String?
  sentBy    String? // which phone/shortcut sent it, free text
  pinned    Boolean   @default(false)
  // First time the head unit saw it — "new link" pop-up until then.
  seenAt    DateTime?
  openedAt  DateTime?
  openCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@map("mappal_dock_item")
}

// Every request that reached /api/dock/inbox — raw, for setting up phone
// share shortcuts (iPhone Shortcuts are hard to debug from the phone).
// Secrets are stripped before saving (token, Authorization, cookies).
// Only the newest 100 are kept.
model DockInboxLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  method      String
  contentType String?
  query       String? // URL query, token removed
  headers     Json // safe headers only
  body        String? // raw body (first 8 KB); multipart fields as JSON
  status      Int // HTTP status we answered
  outcome     String // "created <title>", "401 …", "400 …"
  itemId      String?

  @@index([createdAt])
  @@map("mappal_dock_inbox_log")
}
